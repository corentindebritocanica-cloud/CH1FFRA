{
  "id": "./",
  "name": "Prisme",
  "short_name": "Prisme",
  "description": "Six expériences temps réel calculées sur votre appareil : synthé génératif, fractale 3D, caméra augmentée, diagnostic système, fluides et un million de particules.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#07080d",
  "theme_color": "#07080d",
  "categories": ["entertainment", "music", "photo", "utilities"],
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "edge_side_panel": { "preferred_width": 480 },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Synthé", "short_name": "Synthé", "description": "Instrument génératif", "url": "./#synthe", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Fractale", "short_name": "Fractale", "description": "Mandelbulb en 3D", "url": "./#fractale", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Vision", "short_name": "Vision", "description": "Caméra augmentée", "url": "./#vision", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Nébuleuse", "short_name": "Nébuleuse", "description": "Un million d'étoiles", "url": "./#nebuleuse", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "screenshots": [
    { "src": "icons/screenshot-wide.jpg", "sizes": "1440x900", "type": "image/jpeg", "form_factor": "wide", "label": "L'accueil de Prisme sur ordinateur" },
    { "src": "icons/screenshot-narrow.jpg", "sizes": "880x1912", "type": "image/jpeg", "form_factor": "narrow", "label": "L'accueil de Prisme sur iPhone" }
  ]
}
